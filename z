#!/bin/bash
# Rebuild cepat: sinkron tree dari repo -> source OrangeFox, lalu build lagi.
# (Beda sama "z" kernel di proyek LineageOS - jangan ketuker.)
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FOX_BRANCH="${FOX_BRANCH:-12.1}"
FOX_DIR="${FOX_DIR:-/tmp/fox_${FOX_BRANCH}}"
DEVICE_PATH="device/samsung/a02"

rsync -a --delete \
  --exclude '.git' --exclude '.github' --exclude '_old' --exclude 'out' \
  --exclude 'ulti.sh' --exclude 'z' --exclude 'note.sh' --exclude 'fixlog.sh' \
  --exclude 'README.md' --exclude '.gitignore' \
  "$REPO_DIR/" "$FOX_DIR/$DEVICE_PATH/" || exit 1

cd "$FOX_DIR" || exit 1
export ALLOW_MISSING_DEPENDENCIES=true FOX_BUILD_DEVICE=a02 LC_ALL=C
source build/envsetup.sh
source "$DEVICE_PATH/vendorsetup.sh"
lunch twrp_a02-eng && mka adbd recoveryimage
